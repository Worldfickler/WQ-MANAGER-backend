# Environment variables
PROJECT_NAME=WQ Manager API
VERSION=1.0.0
API_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS (comma separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Set your real connection string only in the ignored .env file.
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
DEBUG=True

# Logging Configuration
LOG_LEVEL=INFO
SQL_ECHO=False
SQL_ECHO_POOL=False
LOG_DIR=logs

# Optional Redis cache. Leave empty to query MySQL directly.
REDIS_URL=
CACHE_EXPIRE_HOUR=13
CACHE_EXPIRE_MINUTE=0
CACHE_TIMEZONE=Asia/Shanghai

# MinIO Object Storage
MINIO_ENDPOINT=http://your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=wqmanager
MINIO_SECURE=False
# Optional public base url for object access
MINIO_PUBLIC_BASE_URL=http://your-minio-host:9000
